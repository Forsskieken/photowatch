# Example of /etc/photowatch/photowatch.env — install as root:root, mode 600.
# systemd reads it with EnvironmentFile=: no export, no quotes, no expansion.
# WEBHOOK_URL holds the only secret of this project.

# The ZFS dataset that is snapshotted and diffed.
DATASET=tank/photos
# Only count paths below this, as `zfs diff` prints them. Empty = count all.
PATH_PREFIX=
# Name part before the date: tank/photos@photowatch-2026-08-29.
SNAPSHOT_PREFIX=photowatch
# Alert from this many deleted files.
THRESHOLD=1
# How long our own snapshots stay (2-365).
KEEP_DAYS=14

# Home Assistant webhook, https only. Generate the id with `openssl rand -hex 32`.
WEBHOOK_URL=https://home.example.net:8123/api/webhook/PUT-THE-WEBHOOK-ID-HERE
# Connect to this IP when DNS fails; the certificate is still checked against
# the host name from WEBHOOK_URL. Empty = use DNS.
HA_IP=

# Where the reports, restore scripts and lists go.
REPORT_DIR=/var/log/photowatch
# Where status.json goes.
STATE_DIR=/var/lib/photowatch
# Absolute path to the zfs command (`command -v zfs`).
ZFS_PATH=/usr/sbin/zfs

# Where the thumbnails go, one subdirectory per day. Must lie OUTSIDE the
# watched dataset, otherwise Immich imports them as photos. Empty = none.
THUMBNAIL_DIR=/mnt/tank/photowatch
# Thumbnails per run (1-200), long side in pixels (64-1024), and the total size
# of THUMBNAIL_DIR above which no new ones are made.
THUMBNAIL_MAX=24
THUMBNAIL_PX=320
THUMBNAIL_MAX_MB=512
# How long the text reports stay (14-3650). Restore scripts, lists and
# thumbnails live KEEP_DAYS + 2 days.
KEEP_DAYS_REPORT=365
